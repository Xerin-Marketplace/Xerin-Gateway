DATABASE_URL=Here is your postgress connection
SECRET_KEY=Here is your secret key 
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
# External delivery provider
DELIVERY_PROVIDER_NAME=dependent-delivery
DELIVERY_API_BASE_URL=https://delivery.example.com/api
DELIVERY_API_KEY=
DELIVERY_API_KEY_HEADER=Authorization
DELIVERY_WEBHOOK_SECRET=replace-with-a-long-random-secret
DELIVERY_QUOTE_PATH=/quotes
DELIVERY_CREATE_PATH=/deliveries
DELIVERY_API_TIMEOUT_SECONDS=30

# AzamPay payment gateway
AZAMPAY_SANDBOX=true
AZAMPAY_APP_NAME=
AZAMPAY_CLIENT_ID=
AZAMPAY_CLIENT_SECRET=
AZAMPAY_API_KEY=
AZAMPAY_VENDOR_ID=
AZAMPAY_VENDOR_NAME=Xerin Marketplace
AZAMPAY_REQUEST_ORIGIN=http://localhost:3000
AZAMPAY_CARD_SUCCESS_URL=http://localhost:3000/payment/success
AZAMPAY_CARD_FAILURE_URL=http://localhost:3000/payment/failed
AZAMPAY_CALLBACK_SECRET=
# Override these only if AzamPay gives your account different endpoint paths.
AZAMPAY_MNO_CHECKOUT_PATH=/azampay/mno/checkout
AZAMPAY_POST_CHECKOUT_PATH=/azampay/checkout
