DATABASE_URL=Here is your postgress connection
SECRET_KEY=Here is your secret key 
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
# External delivery provider
DELIVERY_PROVIDER_NAME=xerin-express
DELIVERY_API_BASE_URL=https://delivery.example.com/api
DELIVERY_API_KEY=
DELIVERY_API_KEY_HEADER=Authorization
DELIVERY_WEBHOOK_SECRET=replace-with-a-long-random-secret
DELIVERY_QUOTE_PATH=/quotes
DELIVERY_CREATE_PATH=/deliveries
DELIVERY_API_TIMEOUT_SECONDS=30

# ── Google OAuth (optional) ──
# Server-side audience check for ID tokens issued to your Web OAuth client.
# Must match NEXT_PUBLIC_GOOGLE_CLIENT_ID on the frontend.
GOOGLE_CLIENT_ID=

# ── Maps / geocoding (optional) ──
# With a key: Google Places + Geocoding power address search and GPS pin.
# Without a key: the API falls back to Nominatim (OpenStreetMap) — free.
GOOGLE_MAPS_API_KEY=
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
NOMINATIM_USER_AGENT=XerinMart/1.0 (+https://xerinmart.com)

# ─── Monitoring & alerting ───
MONITORING_ENABLED=true
# Central ops inbox — receives security alerts + weekly reports
MONITORING_ALERT_EMAIL=airezra2@gmail.com
MONITORING_ALERT_MIN_SEVERITY=warning
MONITORING_ALERT_WINDOW_MINUTES=15
MONITORING_ALERT_MAX_PER_WINDOW=2
ALERT_EMAIL_MAX_ATTEMPTS=5
ALERT_EMAIL_RETRY_BASE_SECONDS=60
MONITORING_WEEKLY_REPORT_ENABLED=true
MONITORING_WEEKLY_REPORT_DAY=MONDAY
MONITORING_WEEKLY_REPORT_TIME=08:00
AUDIT_LOG_RETENTION_DAYS=365
# APP_VERSION=release-tag-or-commit-sha

# Selcom payment gateway (default provider — USSD push + hosted card checkout)
MNO_PAYMENT_PROVIDER=selcom
SELCOM_API_KEY=
SELCOM_API_SECRET=
SELCOM_VENDOR_ID=
SELCOM_BASE_URL=https://apigw.selcommobile.com
SELCOM_CREATE_ORDER_PATH=/v1/checkout/create-order-minimal
SELCOM_WALLET_PAYMENT_PATH=/v1/checkout/wallet-payment
SELCOM_ORDER_STATUS_PATH=/v1/checkout/order-status
SELCOM_WEBHOOK_URL=https://api.xerinmarketplace.com/api/v1/payments/selcom/webhook
SELCOM_REDIRECT_URL=https://xerinmart.com/order-success
SELCOM_CANCEL_URL=https://xerinmart.com/order-failed
SELCOM_TIMEOUT_SECONDS=30
SELCOM_MAX_AMOUNT_TZS=10000000
SELCOM_ORDER_EXPIRY_MINUTES=60
