DATABASE_URL=Here is your postgress connection
SECRET_KEY=Here is your secret key 
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
# External delivery provider
DELIVERY_PROVIDER_NAME=dependent-delivery
DELIVERY_API_BASE_URL=https://delivery.example.com/api
DELIVERY_API_KEY=
DELIVERY_API_KEY_HEADER=Authorization
DELIVERY_WEBHOOK_SECRET=replace-with-a-long-random-secret
DELIVERY_QUOTE_PATH=/quotes
DELIVERY_CREATE_PATH=/deliveries
DELIVERY_API_TIMEOUT_SECONDS=30
# Payment provider routing (new payment attempts only)
MNO_PAYMENT_PROVIDER=azampay
CARD_PAYMENT_PROVIDER=azampay

# ZenoPay Tanzania mobile money
ZENOPAY_API_KEY=
ZENOPAY_BASE_URL=https://zenoapi.com
ZENOPAY_MNO_PAYMENT_PATH=/api/payments/mobile_money_tanzania
ZENOPAY_ORDER_STATUS_PATH=/api/payments/order-status
ZENOPAY_WEBHOOK_URL=https://api.example.com/api/v1/payments/zenopay/webhook
ZENOPAY_TIMEOUT_SECONDS=30
ZENOPAY_MAX_AMOUNT_TZS=5000000
