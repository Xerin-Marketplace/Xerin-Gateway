[Unit]
Description=CloudPay Pesapal Streamlit Demo
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=__PROJECT_DIR__
EnvironmentFile=__PROJECT_DIR__/.env
ExecStart=__PROJECT_DIR__/.venv/bin/streamlit run __PROJECT_DIR__/app.py --server.address 127.0.0.1 --server.port 8501 --server.baseUrlPath pesapal-demo --server.headless true
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
